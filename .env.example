# Initial administrator. These values are only used when the administrator does not exist yet.
APP_ADMIN_USERNAME=root
APP_ADMIN_PASSWORD=change-this-password

# Shared database. The current adapter supports SQLite URLs.
APP_DATABASE_URL=sqlite:///fetch-api/data/fetch.db
APP_DATA_DIR=fetch-api/data

# Collection delay after each accepted video, in seconds.
# The actual pause is randomized in the 70%-150% range of the configured value.
APP_CRAWL_DELAY_SLOTH=10
APP_CRAWL_DELAY_HUMAN=5
APP_CRAWL_DELAY_DEFAULT=1
APP_CRAWL_DELAY_FLASH=0

# Maximum number of crawl tasks that run at the same time across all users.
# Extra tasks wait in queue before starting.
APP_MAX_CONCURRENT_CRAWLS=2

# Comma-separated proxy list used for platform API calls, e.g.
# APP_CRAWL_PROXIES=http://user:pass@host:8080,http://user2:pass2@host2:8080
# Empty value disables proxies. Each crawl session keeps one proxy.
# NOTE: account cookies are bound to the login IP; only enable proxies when
# they route from the same network as the login, or the platform may
# trigger verification on IP change.
APP_CRAWL_PROXIES=

# Xiaomi MiMo analysis.
APP_MIMO_API_KEY=
APP_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
APP_MIMO_MODEL=mimo-v2.5
APP_ANALYSIS_SCAN_INTERVAL_SECONDS=10
# auto uses Base64 for small videos and falls back to the platform CDN URL above 37 MB.
# When APP_PUBLIC_FETCH_API_URL is set, auto uses the signed proxy URL for every video.
APP_MIMO_VIDEO_INPUT_MODE=auto
# Public URL or tunnel that routes to fetch-api, for example https://example.trycloudflare.com
APP_PUBLIC_FETCH_API_URL=
APP_PUBLIC_VIDEO_URL_TTL_SECONDS=1800

# Internal communication. Use the same private value for both backend services.
APP_INTERNAL_API_TOKEN=change-this-internal-token

# Local service settings.
APP_FETCH_API_HOST=127.0.0.1
APP_FETCH_API_PORT=8080
APP_ANALYZE_API_HOST=127.0.0.1
APP_ANALYZE_API_PORT=8090
APP_FETCH_API_URL=http://127.0.0.1:8080
APP_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
APP_AUTH_BROWSER_HEADLESS=false
APP_CRAWL_BROWSER_HEADLESS=true
APP_DOUYIN_CRAWL_HEADLESS=true
# CDP mode (upstream MediaCrawler default): reuse your real Chrome over the
# DevTools protocol. Enable remote debugging first with
#   python3 start_chrome_debug.py
# or open chrome://inspect/#remote-debugging and tick "Allow remote debugging".
# Falls back to the headless profile mode when the CDP port is unreachable.
APP_DOUYIN_CDP_ENABLED=true
APP_DOUYIN_CDP_URL=http://127.0.0.1:9222
APP_DOUYIN_CDP_CONNECT_TIMEOUT_SECONDS=30
APP_SECURITY_VERIFICATION_TIMEOUT_SECONDS=180
APP_COOKIE_SECURE=false

# Feishu (Lark) spreadsheet export. Create a self-built app at
# https://open.feishu.cn (开发者后台 -> 创建企业自建应用), grant the
# "sheets:spreadsheet" (电子表格 读写) permission, publish the app version,
# then fill in the credentials below. FEISHU_SPREADSHEET_TOKEN is optional:
# when empty, the first export auto-creates a spreadsheet named "灵感分析"
# and remembers its token in the database.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPREADSHEET_TOKEN=
# Human owner openid (ou_...) for auto-created spreadsheets. The app identity
# creates documents under the app (bot), which leaves no edit rights for the
# human; set this so the export hands ownership over to you.
FEISHU_OWNER_OPENID=
